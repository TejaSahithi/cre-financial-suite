# ─── Browser-safe variables (VITE_ prefix means Vite bundles these) ──────────
# Only add VITE_ vars here if they are explicitly designed to be public.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# ─── Server-side secrets — DO NOT add VITE_ prefix ───────────────────────────
# These are NEVER read by the browser. Set them via Supabase Edge Function secrets:
#   supabase secrets set AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
#   supabase secrets set AZURE_OPENAI_API_KEY=your-azure-key
#   supabase secrets set AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
#   supabase secrets set AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://your-resource.cognitiveservices.azure.com
#   supabase secrets set AZURE_DOCUMENT_INTELLIGENCE_KEY=your-azure-doc-intel-key
#   supabase secrets set RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxx
#   supabase secrets set TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#   supabase secrets set TWILIO_AUTH_TOKEN=your-twilio-auth-token
#   supabase secrets set TWILIO_FROM_NUMBER=+15551234567
#   # Optional instead of TWILIO_FROM_NUMBER:
#   supabase secrets set TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#   supabase secrets set WORKER_INTERNAL_SECRET=<random-value>
#
# Azure Document Intelligence is the document parser; Azure OpenAI is the
# active LLM provider. Both are required for the lease upload-to-review
# pipeline to function.

# ─── Optional server-side overrides ──────────────────────────────────────────
#   supabase secrets set AZURE_DOCUMENT_INTELLIGENCE_API_VERSION=2024-11-30
#   supabase secrets set AZURE_DOCUMENT_INTELLIGENCE_MODEL_ID=prebuilt-layout
#   supabase secrets set OPENAI_MAX_OUTPUT_TOKENS=16384
#   supabase secrets set EXTRACTION_PROVIDER=azure_document_intelligence
# Whole-document lease extraction experiment (server-side, default off):
#   supabase secrets set BUSINESS_EXTRACTION_PROVIDER=openai_fact_ledger
#   supabase secrets set LEASE_WHOLE_DOCUMENT_LLM_V1=active
#   supabase secrets set LEASE_WHOLE_DOCUMENT_LLM_MAX_INPUT_CHARS=400000
#   supabase secrets set LEASE_WHOLE_DOCUMENT_LLM_MAX_OUTPUT_TOKENS=32768

# ─── Optional local overrides ─────────────────────────────────────────────────
# VITE_LOGIN_URL=/Login
