# ─── Browser-safe variables (VITE_ prefix means Vite bundles these) ──────────
# Only add VITE_ vars here if they are explicitly designed to be public.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# ─── Server-side secrets — DO NOT add VITE_ prefix ───────────────────────────
# These are NEVER read by the browser. Set them via Supabase Edge Function secrets:
#   supabase secrets set RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxx
#   supabase secrets set GOOGLE_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...@....iam.gserviceaccount.com"}'
#   supabase secrets set VERTEX_PROJECT_ID=your-gcp-project-id
#   supabase secrets set VERTEX_LOCATION=us-central1
#   supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
#
# The Google service account needs the "Vertex AI User" IAM role on GCP.

# ─── Optional local overrides ─────────────────────────────────────────────────
# VITE_LOGIN_URL=/Login
# DOCLING_API_URL=http://your-docling-service:5001
